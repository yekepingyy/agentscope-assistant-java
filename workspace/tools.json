{
  "deny": ["web_search", "web_fetch", "execute"],
  "mcpServers": {
    "zhipu-web-search": {
      "transport": "sse",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/sse?Authorization=${MCP_API_KEY}",
      "timeout": "PT60S"
    },
    "zhipu-web-reader": {
      "transport": "sse",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/sse?Authorization=${MCP_API_KEY}",
      "timeout": "PT60S"
    }
  }
}
